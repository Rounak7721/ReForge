# Copy to .env.local and fill in. Never commit .env.local.
# Every var here must also exist in the Vercel project before deploying.

# --- LLM (provider-agnostic layer in lib/llm) ---
# Switching vendor/model is an env change only — see CLAUDE.md.
LLM_PROVIDER=gemini                 # gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=                       # confirm the current free Flash model ID in AI Studio

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — never prefix with NEXT_PUBLIC_

# --- Bonus: website screenshot analysis ---
MICROLINK_API_KEY=                  # optional; the free tier works unauthenticated

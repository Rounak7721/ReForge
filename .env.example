# Copy to .env.local and fill in. Never commit .env.local.
# Every var here must also exist in the Vercel project before deploying.

# --- LLM (provider-agnostic layer in lib/llm) ---
# Switching vendor/model is an env change only — see CLAUDE.md.
LLM_PROVIDER=gemini                 # gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite  # chosen on free-tier QUOTA, not quality — see notes below

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — never prefix with NEXT_PUBLIC_

# --- Demo account (seeded by `pnpm seed:demo`) ---
# Deliberately public — printed in the README so an evaluator can open a finished
# project without spending any of the shared 500/day Gemini quota. Defaults live
# in lib/demo/credentials.ts; set these only to point a fork at its own user.
DEMO_EMAIL=demo@reforge.app
DEMO_PASSWORD=reforge-demo-2026

# --- Bonus: website screenshot analysis ---
MICROLINK_API_KEY=                  # optional; the free tier works unauthenticated

# --- Gemini model notes (verified 2026-08-25 against the live API + AI Studio) ---
# The binding constraint is REQUESTS PER DAY, not RPM. One complete demo flow is
# 6 calls (1 analyze + 1 build + 4 refinements from the brief).
#
#   model                    RPM   RPD   full demos/day
#   gemini-3.6-flash           5    20         3   <- unusable
#   gemini-3.5-flash           5    20         3   <- unusable
#   gemini-3.7-flash           5    20         3   <- unusable, also UNAVAILABLE under load
#   gemini-3.1-flash-lite     15   500        83   <- chosen
#
# gemini-2.5-flash is 404 for new keys. Avoid *-latest aliases; they float.
#
# IMPORTANT: maxOutputTokens caps thinking + output COMBINED. With a lean budget the
# model can spend it all reasoning and return HTTP 200 with content:{} and no parts
# array. See docs/DEBUGGING.md entry 2.
#
# flash-lite emits 0 thinking tokens with NO thinkingConfig, but 118 when
# thinkingLevel:"low" is set — the opposite of 3.6-flash. Do not assume the
# parameter is portable across the family.

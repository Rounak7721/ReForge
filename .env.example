# Copy to .env.local and fill in. Never commit .env.local.
# Every var here must also exist in the Vercel project before deploying.

# --- LLM (provider-agnostic layer in lib/llm) ---
# Switching vendor/model is an env change only — see CLAUDE.md.
LLM_PROVIDER=gemini                 # gemini | openai | anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash       # verified 2026-08-25 against this key — see notes below

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only — never prefix with NEXT_PUBLIC_

# --- Bonus: website screenshot analysis ---
MICROLINK_API_KEY=                  # optional; the free tier works unauthenticated

# --- Gemini model notes (verified 2026-08-25 by probing the live API) ---
# gemini-2.5-flash        404 — "no longer available to new users". Do not use.
# gemini-3.7-flash        UNAVAILABLE ("high demand"); gemini-flash-latest aliases to it
#                         and timed out. Avoid *-latest aliases — they float under you.
# gemini-3.6-flash        chosen. The only candidate where thinkingLevel:"low" actually
#                         zeroes thinking (3.5-flash and 3.1-flash-lite ignore it).
#
# IMPORTANT: maxOutputTokens caps thinking + output COMBINED. With a lean budget the
# model can spend it all reasoning and return HTTP 200 with content:{} and no parts
# array. See docs/DEBUGGING.md entry 2.

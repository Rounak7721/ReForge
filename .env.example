# Copy to .env and fill in. Never commit the filled version.

# ============================================================================
# Model providers
# ============================================================================
# The provider used for analysis, product build and refinement.
# One of: gemini | openai | groq. Switching is an env change only — no code
# edits — which is the contract lib/llm exists to keep. See lib/llm/README.md.
LLM_PROVIDER=gemini

# Only the ACTIVE provider's key is required. The others can stay blank.

# --- Gemini (the deployed runtime provider) ---
# Free tier. The model is pinned on DAILY QUOTA, not quality: the 3.x Flash line
# allows 20 requests/day, flash-lite allows 500. One full demo is 6 calls.
# Avoid `*-latest` aliases — they are unstable and `gemini-2.5-flash` 404s for
# new keys. See project_guidelines/03-tech-stack.md.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Groq (code generation only) ---
# Free tier, measured: 1000 requests/day but only 8000 tokens/MINUTE. The token
# bucket is the binding constraint — one page generation is roughly 2400.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- OpenAI (wired and swappable; no key held on this project) ---
# Present so the provider layer is provably vendor-neutral rather than a Gemini
# wrapper with extra steps. Costs money, so it is not enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Which provider generates code. Falls back to LLM_PROVIDER when blank, which
# is the escape hatch if Groq's free tier changes or the model is withdrawn —
# Groq must never become load-bearing.
CODEGEN_PROVIDER=groq

# ============================================================================
# Supabase
# ============================================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never import the service-role client into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Screenshots (bonus)
# ============================================================================
# Optional. microlink's anonymous tier needs no key and is what the code uses;
# a key raises the rate limit. Capture failures degrade to text-only analysis.
MICROLINK_API_KEY=
